{
  "name": "drum-hero",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-song-offline.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit:changed": "vitest run --changed",
    "mobile:content:export": "node scripts/export-mobile-content.mjs",
    "locales:export": "node scripts/export-localizations.mjs",
    "locales:audit": "node scripts/audit-ui-localization.mjs",
    "device-validation:summary": "node scripts/summarize-device-validation.mjs",
    "trainer-pilot:summary": "node scripts/summarize-trainer-pilot.mjs",
    "mobile:content:validate": "node scripts/validate-mobile-content.mjs",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --grep-invert @visual --project=chromium --project=webkit --project=mobile-chromium",
    "test:e2e:failed": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --last-failed --grep-invert @visual --project=chromium --project=webkit --project=mobile-chromium",
    "test:e2e:smoke": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --grep @smoke --project=chromium",
    "test:e2e:navigation": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/navigation.spec.ts --project=chromium",
    "test:e2e:learning": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/learning.spec.ts --project=chromium",
    "test:e2e:practice": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/practice.spec.ts --project=chromium",
    "test:e2e:trainer": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/trainer.spec.ts --project=chromium",
    "test:e2e:song-library": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/song-library.spec.ts --project=chromium",
    "test:e2e:localization": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/localization.spec.ts --project=chromium",
    "test:e2e:accessibility": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/accessibility.spec.ts --project=chromium",
    "test:e2e:visual": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/visual.spec.ts --grep @visual --project=chromium",
    "test:visual": "npm run test:e2e:visual",
    "qa:fast": "npm run mobile:content:validate && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e:smoke",
    "qa:full": "npm run mobile:content:validate && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run test:e2e:visual",
    "qa": "npm run qa:full"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
