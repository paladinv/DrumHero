    "dashboard.tool.progress.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See completed lessons, best scores, recent work, and your streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta lecciones completadas, mejores puntuaciones, sesiones recientes y tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les leçons terminées, vos meilleurs scores, vos séances récentes et votre série."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh abgeschlossene Lektionen, Bestwerte, letzte Übungen und deine Serie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja aulas concluídas, melhores resultados, práticas recentes e sua sequência."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta lezioni completate, punteggi migliori, sessioni recenti e serie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk voltooide lessen, topscores, recente oefensessies en je reeks."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzaj ukończone lekcje, najlepsze wyniki, ostatnie ćwiczenia i serię."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядай завершені уроки, найкращі результати, останні заняття й серію."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотри завершённые уроки, лучшие результаты, недавние занятия и серию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanan dersleri, en iyi skorları, son çalışmaları ve serini gör."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على الدروس المكتملة وأفضل النتائج والتدريبات الأخيرة وسلسلتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רואים שיעורים שהושלמו, ציוני שיא, אימונים אחרונים והרצף."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درس‌های کامل‌شده، بهترین امتیازها، تمرین‌های اخیر و تداومت را ببین."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे किए पाठ, सर्वोच्च स्कोर, हाल का अभ्यास और लगातार दिनों की श्रृंखला देखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পন্ন পাঠ, সেরা স্কোর, সাম্প্রতিক অনুশীলন এবং ধারাবাহিকতা দেখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مکمل اسباق، بہترین اسکور، حالیہ مشق اور اپنی مسلسل حاضری دیکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat pelajaran selesai, skor terbaik, latihan terbaru, dan rangkaian harimu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem bài học đã hoàn thành, điểm cao nhất, buổi tập gần đây và chuỗi ngày."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูบทเรียนที่จบ คะแนนสูงสุด การฝึกซ้อมล่าสุด และสถิติต่อเนื่อง"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したレッスン、最高スコア、最近の練習、連続日数を確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료한 레슨, 최고 점수, 최근 연습과 연속 기록을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看已完成课程、最佳分数、近期练习和连续练习天数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看已完成課程、最佳分數、近期練習和連續練習天數。"
          }
        }
      }
    },
    "meta.app.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A focused practice studio for drum technique, timing, grooves, and musical confidence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un estudio de práctica enfocado en técnica de batería, ritmo, grooves y confianza musical."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un studio de pratique consacré à la technique de batterie, au rythme, aux grooves et à l’assurance musicale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein fokussiertes Übungsstudio für Schlagzeugtechnik, Timing, Grooves und musikalisches Selbstvertrauen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um estúdio de prática focado em técnica de bateria, tempo, grooves e confiança musical."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno studio di pratica dedicato alla tecnica della batteria, al tempo, ai groove e alla sicurezza musicale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gerichte oefenstudio voor drumtechniek, timing, grooves en muzikaal zelfvertrouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio ćwiczeń skupione na technice gry na perkusji, timingu, groove’ach i pewności muzycznej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Студія для практики техніки гри на барабанах, таймінгу, грувів і музичної впевненості."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Студия для занятий барабанной техникой, таймингом, грувами и музыкальной уверенностью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davul tekniği, zamanlama, groove ve müzikal özgüvene odaklanan bir çalışma stüdyosu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استوديو تدريب يركّز على تقنية الطبول والتوقيت والإيقاعات والثقة الموسيقية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אולפן אימון ממוקד לטכניקת תופים, תזמון, גרובים וביטחון מוזיקלי."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "استودیوی تمرین متمرکز بر تکنیک درام، زمان‌بندی، گروو و اعتمادبه‌نفس موسیقایی."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्रम तकनीक, टाइमिंग, ग्रोव और संगीत के आत्मविश्वास के लिए केंद्रित अभ्यास स्टूडियो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ড্রাম কৌশল, টাইমিং, গ্রুভ এবং সংগীতের আত্মবিশ্বাসের জন্য মনোযোগী অনুশীলন স্টুডিও।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈرم کی تکنیک، ٹائمنگ، گرووز اور موسیقی کے اعتماد کے لیے مخصوص مشقی اسٹوڈیو۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio latihan terarah untuk teknik drum, ketepatan waktu, groove, dan kepercayaan diri bermusik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gian luyện tập tập trung vào kỹ thuật trống, nhịp, groove và sự tự tin âm nhạc."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สตูดิโอฝึกซ้อมที่เน้นเทคนิคกลอง จังหวะ กรูฟ และความมั่นใจทางดนตรี"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラムのテクニック、タイミング、グルーヴ、音楽的な自信を身につける練習スタジオ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드럼 테크닉, 타이밍, 그루브와 음악적 자신감을 위한 집중 연습 스튜디오입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注于鼓技、节奏、律动和音乐自信的练习工作室。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專注於鼓技、節奏、律動和音樂自信的練習工作室。"
          }
        }
      }
    },
    "lesson.meet-the-kit.idea": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A drum kit is a group of distinct voices. A relaxed setup lets each limb reach its instrument without twisting or lifting the shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende las voces principales, prepara bien tu equipo y escucha con seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprenez les principales sonorités, installez-vous correctement et écoutez sans risque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne die wichtigsten Klänge kennen, richte dein Set ausgewogen ein und schütze dein Gehör."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprenda os timbres principais, ajuste o instrumento e proteja sua audição."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara i suoni principali, regola il set in modo equilibrato e proteggi l’udito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer de belangrijkste klanken, stel je set goed op en bescherm je gehoor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznaj podstawowe brzmienia, ustaw wygodnie instrument i chroń słuch."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчи основні тембри, зручно налаштуй установку й бережи слух."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучи основные тембры, удобно настрой установку и береги слух."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel sesleri öğren, setini dengeli kur ve işitmeni koru."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرّف على الأصوات الأساسية واضبط جلستك واحمِ سمعك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למדו את הצלילים הבסיסיים, כוונו את המערכת בנוחות ושמרו על השמיעה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صداهای اصلی را بشناسید، ساز را راحت تنظیم کنید و از شنوایی محافظت کنید."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य ध्वनियाँ सीखें, किट को संतुलित रखें और सुनने की सुरक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল সুরগুলো শিখুন, কিটটি ভারসাম্য করে সাজান এবং শ্রবণশক্তির যত্ন নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اہم آوازیں سیکھیں، سیٹ درست رکھیں اور سماعت کی حفاظت کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelajari warna suara utama, atur kit dengan seimbang, dan jaga pendengaran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Học các âm sắc chính, bố trí bộ trống cân bằng và bảo vệ thính giác."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียนรู้เสียงหลัก จัดชุดกลองให้สมดุล และดูแลการได้ยิน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本の音を覚え、無理のない配置にして、耳を守りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주요 소리를 배우고 균형 있게 설치하며 청력을 보호하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解主要鼓声，合理摆放鼓组，并保护听力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "了解主要鼓聲，合理擺放鼓組，並保護聽力。"
          }
        }
      }
    },
    "lesson.meet-the-kit.step.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name kick, snare, hi-hat, tom, and crash. On the Practice Pad, those voices use Space, F, J, K, and L."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a un tempo cómodo y di la cuenta en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à un tempo confortable et comptez à voix haute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne in einem angenehmen Tempo und zähle laut mit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece em um andamento confortável e fale a contagem em voz alta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a un tempo comodo e pronuncia il conteggio ad alta voce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin op een prettig tempo en tel hardop mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij w wygodnym tempie i licz na głos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почни у зручному темпі й рахуй уголос."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начни в удобном темпе и считай вслух."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat bir tempoda başla ve sayımı sesli yap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بسرعة مريحة وردّد العد بصوت مسموع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחילו בקצב נוח וספרו בקול."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با سرعتی راحت شروع کن و شمارش را با صدای بلند بگو."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आरामदायक गति से शुरू करें और गिनती बोलकर करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বচ্ছন্দ গতিতে শুরু করুন এবং জোরে গুনুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرام دہ رفتار سے شروع کریں اور گنتی بلند آواز میں کہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan tempo nyaman dan ucapkan hitungan dengan lantang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu ở tốc độ thoải mái và đếm thành tiếng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มด้วยความเร็วที่สบายและนับออกเสียง"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無理のないテンポで始め、声に出して数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안한 템포로 시작하고 소리 내어 세세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从舒适的速度开始，并大声数拍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從舒適的速度開始，並大聲數拍。"
          }
        }
      }
    },
    "lesson.meet-the-kit.step.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit so your thighs slope slightly down and your feet can rest on the pedals without reaching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el patrón despacio y mantén iguales las subdivisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez lentement en espaçant régulièrement chaque subdivision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele das Muster langsam und halte alle Unterteilungen gleichmäßig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque o padrão devagar e mantenha as subdivisões igualmente espaçadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona lentamente e mantieni regolare la distanza tra le suddivisioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel het patroon langzaam en houd elke onderverdeling gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graj powoli, zachowując równe odstępy między podziałami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грай повільно, рівномірно розподіляючи кожен підрозділ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играй медленно, равномерно распределяя каждую долю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş çal; her alt bölümü eşit aralıklarla yerleştir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزف النمط ببطء وحافظ على تساوي المسافات بين التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נגנו לאט ושמרו על מרווחים שווים בין החלוקות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهسته بنواز و فاصلهٔ تقسیم‌ها را برابر نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे बजाएँ और हर उपविभाजन के बीच बराबर दूरी रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধীরে বাজান; প্রতিটি উপবিভাগের ব্যবধান সমান রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آہستہ بجائیں اور ہر ذیلی تقسیم کا فاصلہ برابر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainkan perlahan; jaga jarak setiap subdivisi tetap sama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi chậm, giữ khoảng cách giữa các phân nhịp bằng nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นช้า ๆ โดยเว้นระยะของแต่ละจังหวะย่อยให้เท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり演奏し、各細分の間隔を均等に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 연주하며 각 세분의 간격을 고르게 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，让每个细分之间的间隔保持均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，讓每個細分之間的間隔保持均勻。"
          }
        }
      }
    },
    "lesson.meet-the-kit.step.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use hearing protection around acoustic drums and keep headphone or monitor levels comfortable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repítelo hasta tocarlo con soltura y regularidad; después, sube un poco el tempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez jusqu’à jouer avec aisance et régularité, puis augmentez légèrement le tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole es entspannt und gleichmäßig, dann erhöhe das Tempo leicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita até tocar com tranquilidade e constância; depois, aumente um pouco o andamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti finché il gesto è rilassato e uniforme, poi aumenta leggermente il tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhaal tot het ontspannen en gelijkmatig voelt; verhoog daarna het tempo een beetje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powtarzaj, aż ruch będzie swobodny i równy, a potem lekko zwiększ tempo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторюй, доки рух не стане вільним і рівним, тоді трохи прискорся."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяй, пока движения не станут свободными и ровными, затем немного ускорься."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat ve dengeli olana kadar tekrarla, sonra tempoyu biraz artır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرّر حتى يصبح العزف مريحًا ومنتظمًا، ثم زد السرعة قليلًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזרו עד שהנגינה נינוחה ואחידה, ואז הגבירו מעט את הקצב."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا وقتی حرکت راحت و یکنواخت شود تکرار کن، سپس کمی سرعت را بالا ببر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम और समानता आने तक दोहराएँ, फिर गति थोड़ी बढ़ाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বচ্ছন্দ ও সমান না হওয়া পর্যন্ত পুনরাবৃত্তি করুন, তারপর গতি সামান্য বাড়ান।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرام اور یکسانیت آنے تک دہرائیں، پھر رفتار تھوڑی بڑھائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulangi sampai terasa santai dan rata, lalu naikkan tempo sedikit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lặp lại đến khi thấy thư giãn và đều, rồi tăng tốc một chút."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นซ้ำจนรู้สึกผ่อนคลายและสม่ำเสมอ แล้วค่อยเพิ่มความเร็วเล็กน้อย"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "力まず均等に演奏できるまで繰り返し、その後少しだけテンポを上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안하고 고르게 연주될 때까지 반복한 뒤 템포를 조금 높이세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复练习，直到动作放松且均匀，再稍微加快速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複練習，直到動作放鬆且均勻，再稍微加快速度。"
          }
        }
      }
    },
    "lesson.meet-the-kit.goal.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name five kit voices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a un tempo cómodo y di la cuenta en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à un tempo confortable et comptez à voix haute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne in einem angenehmen Tempo und zähle laut mit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece em um andamento confortável e fale a contagem em voz alta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a un tempo comodo e pronuncia il conteggio ad alta voce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin op een prettig tempo en tel hardop mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij w wygodnym tempie i licz na głos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почни у зручному темпі й рахуй уголос."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начни в удобном темпе и считай вслух."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat bir tempoda başla ve sayımı sesli yap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بسرعة مريحة وردّد العد بصوت مسموع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחילו בקצב נוח וספרו בקול."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با سرعتی راحت شروع کن و شمارش را با صدای بلند بگو."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आरामदायक गति से शुरू करें और गिनती बोलकर करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বচ্ছন্দ গতিতে শুরু করুন এবং জোরে গুনুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرام دہ رفتار سے شروع کریں اور گنتی بلند آواز میں کہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan tempo nyaman dan ucapkan hitungan dengan lantang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu ở tốc độ thoải mái và đếm thành tiếng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มด้วยความเร็วที่สบายและนับออกเสียง"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無理のないテンポで始め、声に出して数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안한 템포로 시작하고 소리 내어 세세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从舒适的速度开始，并大声数拍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從舒適的速度開始，並大聲數拍。"
          }
        }
      }
    },
    "lesson.meet-the-kit.goal.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a relaxed seat height"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el patrón despacio y mantén iguales las subdivisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez lentement en espaçant régulièrement chaque subdivision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele das Muster langsam und halte alle Unterteilungen gleichmäßig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque o padrão devagar e mantenha as subdivisões igualmente espaçadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona lentamente e mantieni regolare la distanza tra le suddivisioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel het patroon langzaam en houd elke onderverdeling gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graj powoli, zachowując równe odstępy między podziałami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грай повільно, рівномірно розподіляючи кожен підрозділ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играй медленно, равномерно распределяя каждую долю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş çal; her alt bölümü eşit aralıklarla yerleştir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزف النمط ببطء وحافظ على تساوي المسافات بين التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נגנו לאט ושמרו על מרווחים שווים בין החלוקות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهسته بنواز و فاصلهٔ تقسیم‌ها را برابر نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे बजाएँ और हर उपविभाजन के बीच बराबर दूरी रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধীরে বাজান; প্রতিটি উপবিভাগের ব্যবধান সমান রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آہستہ بجائیں اور ہر ذیلی تقسیم کا فاصلہ برابر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainkan perlahan; jaga jarak setiap subdivisi tetap sama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi chậm, giữ khoảng cách giữa các phân nhịp bằng nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นช้า ๆ โดยเว้นระยะของแต่ละจังหวะย่อยให้เท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり演奏し、各細分の間隔を均等に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 연주하며 각 세분의 간격을 고르게 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，让每个细分之间的间隔保持均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，讓每個細分之間的間隔保持均勻。"
          }
        }
      }
    },
