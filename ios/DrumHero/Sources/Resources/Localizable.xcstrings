    "pattern.twelve-eight-shuffle.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A spacious triplet-grid groove with a rolling ride guide and backbeat on beats two and four."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio de Blues en 12/8. Sigue el patrón a un tempo cómodo y mantén parejas las subdivisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice Blues en 12/8. Suivez le motif à un tempo confortable et gardez des subdivisions régulières."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Blues-Übung im Takt 12/8. Folge dem Muster in bequemem Tempo und halte die Unterteilungen gleichmäßig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercício de Blues em 12/8. Siga o padrão em um andamento confortável e mantenha as subdivisões regulares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizio Blues in 12/8. Segui il pattern a un tempo comodo e mantieni regolari le suddivisioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Blues-oefening in 12/8. Volg het patroon op een prettig tempo en houd de onderverdelingen gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenie Blues w metrum 12/8. Graj wzór w wygodnym tempie i zachowaj równe podziały."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вправа у стилі Blues в розмірі 12/8. Грай у зручному темпі та тримай рівні підрозділи."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнение в стиле Blues и размере 12/8. Играй в удобном темпе и соблюдай ровные доли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "12/8 ölçüsünde Blues çalışması. Kalıbı rahat bir tempoda izle ve alt bölümleri eşit tut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرين Blues بإيقاع 12/8. اتبع النمط بسرعة مريحة وحافظ على تساوي التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגיל Blues במשקל 12/8. נגנו בקצב נוח ושמרו על חלוקות שוות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرین Blues در میزان 12/8. الگو را با سرعتی راحت بنواز و تقسیمات را یکسان نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "12/8 में Blues अभ्यास। आरामदायक गति से पैटर्न बजाएँ और उपविभाजनों को बराबर रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "12/8 মাত্রায় Blues অনুশীলন। স্বচ্ছন্দ গতিতে প্যাটার্নটি অনুসরণ করুন এবং উপবিভাগ সমান রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "12/8 میں Blues کی مشق۔ آرام دہ رفتار سے پیٹرن بجائیں اور ذیلی تقسیمیں برابر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Blues dalam birama 12/8. Ikuti pola dengan tempo nyaman dan jaga setiap subdivisi tetap rata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài tập Blues ở nhịp 12/8. Theo mẫu ở tốc độ thoải mái và giữ các phân nhịp đều nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบฝึก Blues ในจังหวะ 12/8 เล่นตามรูปแบบด้วยความเร็วที่สบายและแบ่งจังหวะให้เท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12/8のBlues練習です。無理のないテンポでパターンを追い、細分を均等に保ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12/8의 Blues 연습입니다. 편안한 템포로 패턴을 따라가며 세분을 고르게 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "12/8的Blues练习。用舒适的速度跟随节奏型，并保持细分均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "12/8的Blues練習。用舒適的速度跟隨節奏型，並保持細分均勻。"
          }
        }
      }
    },
    "pattern.twelve-eight-shuffle.focus": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold four triplet groups with a deep backbeat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un pulso constante y acentos claros en este patrón de Blues."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez une pulsation stable et des accents nets dans ce motif Blues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Puls stabil und setze klare Akzente in diesem Blues-Muster."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a pulsação firme e os acentos claros neste padrão de Blues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni un pulsare costante e accenti chiari in questo pattern Blues."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de puls stabiel en de accenten duidelijk in dit Blues-patroon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj równy puls i wyraźne akcenty w tym wzorze Blues."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримай рівний пульс і чіткі акценти у вправі Blues."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держи ровный пульс и чёткие акценты в упражнении Blues."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Blues kalıbında vuruşu sabit, vurguları net tut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على نبض ثابت ونبرات واضحة في نمط Blues."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו על פעמה יציבה והדגשות ברורות בתרגיל Blues."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این الگوی Blues ضربی ثابت و تأکیدهایی روشن نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Blues पैटर्न में स्थिर ताल और स्पष्ट ज़ोर बनाए रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Blues প্যাটার্নে স্থির পালস ও স্পষ্ট অ্যাকসেন্ট রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Blues پیٹرن میں مستقل لے اور واضح زور برقرار رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga pulsa tetap stabil dan aksen tetap jelas dalam pola Blues ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nhịp ổn định và nhấn rõ trong mẫu Blues này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาจังหวะให้สม่ำเสมอและเน้นเสียงให้ชัดในรูปแบบ Blues นี้"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このBluesパターンでは、安定した拍と明確なアクセントを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Blues 패턴에서 박을 일정하게 유지하고 강세를 또렷하게 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
