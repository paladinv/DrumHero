            "value": "Mulai dengan tempo nyaman dan ucapkan hitungan dengan lantang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu ở tốc độ thoải mái và đếm thành tiếng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มด้วยความเร็วที่สบายและนับออกเสียง"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無理のないテンポで始め、声に出して数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안한 템포로 시작하고 소리 내어 세세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从舒适的速度开始，并大声数拍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從舒適的速度開始，並大聲數拍。"
          }
        }
      }
    },
    "lesson.count-the-grid.goal.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the playhead"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el patrón despacio y mantén iguales las subdivisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez lentement en espaçant régulièrement chaque subdivision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele das Muster langsam und halte alle Unterteilungen gleichmäßig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque o padrão devagar e mantenha as subdivisões igualmente espaçadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona lentamente e mantieni regolare la distanza tra le suddivisioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel het patroon langzaam en houd elke onderverdeling gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graj powoli, zachowując równe odstępy między podziałami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грай повільно, рівномірно розподіляючи кожен підрозділ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играй медленно, равномерно распределяя каждую долю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş çal; her alt bölümü eşit aralıklarla yerleştir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزف النمط ببطء وحافظ على تساوي المسافات بين التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נגנו לאט ושמרו על מרווחים שווים בין החלוקות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهسته بنواز و فاصلهٔ تقسیم‌ها را برابر نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे बजाएँ और हर उपविभाजन के बीच बराबर दूरी रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধীরে বাজান; প্রতিটি উপবিভাগের ব্যবধান সমান রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آہستہ بجائیں اور ہر ذیلی تقسیم کا فاصلہ برابر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainkan perlahan; jaga jarak setiap subdivisi tetap sama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi chậm, giữ khoảng cách giữa các phân nhịp bằng nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นช้า ๆ โดยเว้นระยะของแต่ละจังหวะย่อยให้เท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり演奏し、各細分の間隔を均等に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 연주하며 각 세분의 간격을 고르게 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，让每个细分之间的间隔保持均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，讓每個細分之間的間隔保持均勻。"
          }
        }
      }
    },
    "lesson.count-the-grid.goal.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a steady pulse"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repítelo hasta tocarlo con soltura y regularidad; después, sube un poco el tempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez jusqu’à jouer avec aisance et régularité, puis augmentez légèrement le tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole es entspannt und gleichmäßig, dann erhöhe das Tempo leicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita até tocar com tranquilidade e constância; depois, aumente um pouco o andamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti finché il gesto è rilassato e uniforme, poi aumenta leggermente il tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhaal tot het ontspannen en gelijkmatig voelt; verhoog daarna het tempo een beetje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powtarzaj, aż ruch będzie swobodny i równy, a potem lekko zwiększ tempo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторюй, доки рух не стане вільним і рівним, тоді трохи прискорся."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяй, пока движения не станут свободными и ровными, затем немного ускорься."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat ve dengeli olana kadar tekrarla, sonra tempoyu biraz artır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرّر حتى يصبح العزف مريحًا ومنتظمًا، ثم زد السرعة قليلًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזרו עד שהנגינה נינוחה ואחידה, ואז הגבירו מעט את הקצב."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا وقتی حرکت راحت و یکنواخت شود تکرار کن، سپس کمی سرعت را بالا ببر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम और समानता आने तक दोहराएँ, फिर गति थोड़ी बढ़ाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বচ্ছন্দ ও সমান না হওয়া পর্যন্ত পুনরাবৃত্তি করুন, তারপর গতি সামান্য বাড়ান।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرام اور یکسانیت آنے تک دہرائیں، پھر رفتار تھوڑی بڑھائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulangi sampai terasa santai dan rata, lalu naikkan tempo sedikit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lặp lại đến khi thấy thư giãn và đều, rồi tăng tốc một chút."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นซ้ำจนรู้สึกผ่อนคลายและสม่ำเสมอ แล้วค่อยเพิ่มความเร็วเล็กน้อย"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "力まず均等に演奏できるまで繰り返し、その後少しだけテンポを上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안하고 고르게 연주될 때까지 반복한 뒤 템포를 조금 높이세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复练习，直到动作放松且均匀，再稍微加快速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複練習，直到動作放鬆且均勻，再稍微加快速度。"
          }
        }
      }
    },
    "lesson.first-backbeat.idea": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A common rock and pop groove pairs kick on beats 1 and 3 with snare on beats 2 and 4. Even hi-hat eighths connect the pattern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordina bombo, caja y charles en un ritmo completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordonnez grosse caisse, caisse claire et charleston dans un groove complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordiniere Bassdrum, Snare und Hi-Hat zu einem vollständigen Groove."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordene bumbo, caixa e chimbal em um groove completo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordina cassa, rullante e hi-hat in un groove completo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coördineer kick, snare en hi-hat tot een complete groove."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz stopę, werbel i hi-hat w pełny groove."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поєднай бас-барабан, малий барабан і хай-хет у повний грув."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соедини бас-барабан, малый барабан и хай-хэт в полный грув."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bas davul, trampet ve hi-hat’i tam bir groove içinde eşgüdümle."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسّق بين الطبل الكبير والصغير والهاي هات في إيقاع كامل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תאמו בין בס, סנר והיי-האט לגרוב מלא."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیک، اسنیر و های‌هت را در یک گروو کامل هماهنگ کنید."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किक, स्नेयर और हाय-हैट को पूरे ग्रूव में समन्वित करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিক, স্নেয়ার ও হাই-হ্যাট মিলিয়ে পূর্ণ গ্রুভ তৈরি করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کِک، اسنیر اور ہائی ہیٹ کو مکمل گروو میں ہم آہنگ کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinasikan kick, snare, dan hi-hat menjadi groove utuh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phối hợp kick, snare và hi-hat thành một groove hoàn chỉnh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประสานกระเดื่อง สแนร์ และไฮแฮตให้เป็นกรูฟเต็มรูปแบบ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キック、スネア、ハイハットを組み合わせてグルーヴを作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "킥, 스네어, 하이햇을 조화시켜 완전한 그루브를 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协调底鼓、军鼓和踩镲，组成完整律动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "協調大鼓、小鼓和踩鈸，組成完整律動。"
          }
        }
      }
    },
    "lesson.first-backbeat.step.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count “1 & 2 & 3 & 4 &” before playing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a un tempo cómodo y di la cuenta en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à un tempo confortable et comptez à voix haute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne in einem angenehmen Tempo und zähle laut mit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece em um andamento confortável e fale a contagem em voz alta."
          }
        },
