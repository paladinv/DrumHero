            "value": "كرّر حتى يصبح العزف مريحًا ومنتظمًا، ثم زد السرعة قليلًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזרו עד שהנגינה נינוחה ואחידה, ואז הגבירו מעט את הקצב."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا وقتی حرکت راحت و یکنواخت شود تکرار کن، سپس کمی سرعت را بالا ببر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम और समानता आने तक दोहराएँ, फिर गति थोड़ी बढ़ाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বচ্ছন্দ ও সমান না হওয়া পর্যন্ত পুনরাবৃত্তি করুন, তারপর গতি সামান্য বাড়ান।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرام اور یکسانیت آنے تک دہرائیں، پھر رفتار تھوڑی بڑھائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulangi sampai terasa santai dan rata, lalu naikkan tempo sedikit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lặp lại đến khi thấy thư giãn và đều, rồi tăng tốc một chút."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นซ้ำจนรู้สึกผ่อนคลายและสม่ำเสมอ แล้วค่อยเพิ่มความเร็วเล็กน้อย"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "力まず均等に演奏できるまで繰り返し、その後少しだけテンポを上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안하고 고르게 연주될 때까지 반복한 뒤 템포를 조금 높이세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复练习，直到动作放松且均匀，再稍微加快速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複練習，直到動作放鬆且均勻，再稍微加快速度。"
          }
        }
      }
    },
    "lesson.paradiddle-voices.idea": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single paradiddle is R-L-R-R, L-R-L-L. The repeated strokes are doubles; accents can make the sticking easier to hear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte la técnica de manos en movimiento musical entre caja y toms."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez les doigtés en mouvement musical entre caisse claire et toms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwandle das Handmuster in musikalische Bewegung zwischen Snare und Toms."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme a técnica de mãos em movimento musical entre caixa e tons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma la tecnica delle mani in movimento musicale tra rullante e tom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak van je handzetting muzikale beweging tussen snare en toms."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamień układ rąk w muzyczny ruch między werblem a tomami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетвори аплікатуру на музичний рух між малим барабаном і томами."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преврати аппликатуру в музыкальное движение между малым барабаном и томами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "El düzenini trampet ve tomlar arasında müzikal harekete dönüştür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوّل ترتيب اليدين إلى حركة موسيقية بين الطبل الصغير والتوم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפכו את תנועת הידיים לתנועה מוזיקלית בין הסנר לטומים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "الگوی دست را به حرکتی موسیقایی میان اسنیر و تام‌ها تبدیل کنید."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथों के पैटर्न को स्नेयर और टॉम के बीच संगीतमय गति दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হাতের বিন্যাসকে স্নেয়ার ও টমের মাঝে সুরেলা চলনে রূপ দিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاتھوں کے پیٹرن کو اسنیر اور ٹامز کے درمیان موسیقی کی حرکت دیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah pola tangan menjadi gerak musikal antara snare dan tom."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến cách đánh tay thành chuyển động âm nhạc giữa snare và tom."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนรูปแบบมือให้เป็นการเคลื่อนไหวทางดนตรีระหว่างสแนร์กับทอม"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手順をスネアとタムの間の音楽的な動きに変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손의 패턴을 스네어와 탐 사이의 음악적 움직임으로 바꾸세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让手法在军鼓和通鼓之间形成音乐性的移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓手法在小鼓和通鼓之間形成音樂性的移動。"
          }
        }
      }
    },
    "lesson.paradiddle-voices.step.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say the sticking out loud and make the repeated hand change feel smooth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a un tempo cómodo y di la cuenta en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à un tempo confortable et comptez à voix haute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne in einem angenehmen Tempo und zähle laut mit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece em um andamento confortável e fale a contagem em voz alta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a un tempo comodo e pronuncia il conteggio ad alta voce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin op een prettig tempo en tel hardop mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij w wygodnym tempie i licz na głos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почни у зручному темпі й рахуй уголос."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начни в удобном темпе и считай вслух."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat bir tempoda başla ve sayımı sesli yap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بسرعة مريحة وردّد العد بصوت مسموع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחילו בקצב נוח וספרו בקול."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با سرعتی راحت شروع کن و شمارش را با صدای بلند بگو."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आरामदायक गति से शुरू करें और गिनती बोलकर करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বচ্ছন্দ গতিতে শুরু করুন এবং জোরে গুনুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرام دہ رفتار سے شروع کریں اور گنتی بلند آواز میں کہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan tempo nyaman dan ucapkan hitungan dengan lantang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu ở tốc độ thoải mái và đếm thành tiếng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มด้วยความเร็วที่สบายและนับออกเสียง"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無理のないテンポで始め、声に出して数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안한 템포로 시작하고 소리 내어 세세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从舒适的速度开始，并大声数拍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從舒適的速度開始，並大聲數拍。"
          }
        }
      }
    },
    "lesson.paradiddle-voices.step.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accent the first note of each four-note group while keeping the other notes lower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el patrón despacio y mantén iguales las subdivisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez lentement en espaçant régulièrement chaque subdivision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele das Muster langsam und halte alle Unterteilungen gleichmäßig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque o padrão devagar e mantenha as subdivisões igualmente espaçadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona lentamente e mantieni regolare la distanza tra le suddivisioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel het patroon langzaam en houd elke onderverdeling gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graj powoli, zachowując równe odstępy między podziałami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грай повільно, рівномірно розподіляючи кожен підрозділ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играй медленно, равномерно распределяя каждую долю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş çal; her alt bölümü eşit aralıklarla yerleştir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزف النمط ببطء وحافظ على تساوي المسافات بين التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נגנו לאט ושמרו על מרווחים שווים בין החלוקות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهسته بنواز و فاصلهٔ تقسیم‌ها را برابر نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे बजाएँ और हर उपविभाजन के बीच बराबर दूरी रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধীরে বাজান; প্রতিটি উপবিভাগের ব্যবধান সমান রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آہستہ بجائیں اور ہر ذیلی تقسیم کا فاصلہ برابر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainkan perlahan; jaga jarak setiap subdivisi tetap sama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi chậm, giữ khoảng cách giữa các phân nhịp bằng nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นช้า ๆ โดยเว้นระยะของแต่ละจังหวะย่อยให้เท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり演奏し、各細分の間隔を均等に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 연주하며 각 세분의 간격을 고르게 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，让每个细分之间的间隔保持均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，讓每個細分之間的間隔保持均勻。"
          }
        }
      }
    },
    "lesson.paradiddle-voices.step.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move selected notes from snare to tom without changing the sticking or pulse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repítelo hasta tocarlo con soltura y regularidad; después, sube un poco el tempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez jusqu’à jouer avec aisance et régularité, puis augmentez légèrement le tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole es entspannt und gleichmäßig, dann erhöhe das Tempo leicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita até tocar com tranquilidade e constância; depois, aumente um pouco o andamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
