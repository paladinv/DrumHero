    "dashboard.tool.trainer.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practise with adjustable rounds, adaptive tempo, calibrated inputs, and setlist follow-along."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica con rondas ajustables, tempo adaptativo, entradas calibradas y acompañamiento de listas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînez-vous avec des séries réglables, un tempo adaptatif, des entrées calibrées et un accompagnement de setlist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe mit anpassbaren Runden, adaptivem Tempo, kalibrierten Eingängen und Setlist-Begleitung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique com rodadas ajustáveis, andamento adaptativo, entradas calibradas e acompanhamento de setlist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercitati con round regolabili, tempo adattivo, ingressi calibrati e accompagnamento della scaletta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen met instelbare rondes, adaptief tempo, gekalibreerde invoer en begeleiding bij een setlist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz w regulowanych rundach, z adaptacyjnym tempem, skalibrowanym wejściem i podkładem do setlisty."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Практикуйся в налаштовуваних раундах з адаптивним темпом, каліброваними входами й супроводом плейлиста."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занимайся в настраиваемых раундах с адаптивным темпом, откалиброванным вводом и сопровождением сет-листа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlanabilir turlar, uyarlanabilir tempo, kalibre edilmiş girişler ve setlist eşliğiyle çalış."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرّب بجولات قابلة للضبط وإيقاع متكيّف ومدخلات معايرة ومرافقة قائمة الأغاني."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתאמנים בסבבים מותאמים, בקצב מסתגל, בכניסות מכוילות ובליווי רשימת שירים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با دورهای قابل تنظیم، تمپوی تطبیقی، ورودی‌های کالیبره و همراهی فهرست اجرا تمرین کن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समायोज्य राउंड, बदलते टेम्पो, कैलिब्रेट किए इनपुट और सेटलिस्ट साथ के साथ अभ्यास करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিয়ন্ত্রণযোগ্য রাউন্ড, মানিয়ে নেওয়া টেম্পো, ক্যালিব্রেট করা ইনপুট এবং সেটলিস্ট অনুসরণসহ অনুশীলন করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حسبِ ضرورت راؤنڈز، بدلتے ٹیمپو، کیلیبریٹڈ اِن پٹس اور سیٹ لسٹ کی ہم نوائی کے ساتھ مشق کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlatih dengan ronde yang bisa diatur, tempo adaptif, input terkalibrasi, dan iringan setlist."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện tập với vòng chơi tùy chỉnh, nhịp độ thích ứng, đầu vào đã hiệu chỉnh và phần đệm theo danh sách bài."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝึกด้วยรอบที่ปรับได้ เทมโปที่ปรับตามผล อินพุตที่ปรับเทียบ และการเล่นตามเซ็ตลิสต์"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回数を調整できる練習、適応テンポ、調整済み入力、セットリスト再生に対応。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조절 가능한 라운드, 적응형 템포, 보정된 입력, 세트리스트 재생으로 연습하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用可调轮次、自适应速度、校准输入和歌单跟练来练习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用可調整回合、自適應速度、校準輸入和歌單跟練來練習。"
          }
        }
      }
    },
