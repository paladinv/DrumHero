    "pattern.five-four-half-time.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open five-beat groove with a half-time backbeat and a steady eighth-note guide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio de Compás irregular en 5/4. Sigue el patrón a un tempo cómodo y mantén parejas las subdivisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice Mesure asymétrique en 5/4. Suivez le motif à un tempo confortable et gardez des subdivisions régulières."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ungerader Takt-Übung im Takt 5/4. Folge dem Muster in bequemem Tempo und halte die Unterteilungen gleichmäßig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercício de Compasso ímpar em 5/4. Siga o padrão em um andamento confortável e mantenha as subdivisões regulares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizio Metro dispari in 5/4. Segui il pattern a un tempo comodo e mantieni regolari le suddivisioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Oneven maatsoort-oefening in 5/4. Volg het patroon op een prettig tempo en houd de onderverdelingen gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenie Metrum nieparzyste w metrum 5/4. Graj wzór w wygodnym tempie i zachowaj równe podziały."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вправа у стилі Непарний розмір в розмірі 5/4. Грай у зручному темпі та тримай рівні підрозділи."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнение в стиле Нечётный размер и размере 5/4. Играй в удобном темпе и соблюдай ровные доли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5/4 ölçüsünde Aksak ölçü çalışması. Kalıbı rahat bir tempoda izle ve alt bölümleri eşit tut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرين ميزان فردي بإيقاع 5/4. اتبع النمط بسرعة مريحة وحافظ على تساوي التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגיל משקל אי־זוגי במשקל 5/4. נגנו בקצב נוח ושמרו על חלוקות שוות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرین میزان فرد در میزان 5/4. الگو را با سرعتی راحت بنواز و تقسیمات را یکسان نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5/4 में विषम ताल अभ्यास। आरामदायक गति से पैटर्न बजाएँ और उपविभाजनों को बराबर रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "5/4 মাত্রায় বিজোড় মাত্রা অনুশীলন। স্বচ্ছন্দ গতিতে প্যাটার্নটি অনুসরণ করুন এবং উপবিভাগ সমান রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "5/4 میں طاق میزان کی مشق۔ آرام دہ رفتار سے پیٹرن بجائیں اور ذیلی تقسیمیں برابر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Birama ganjil dalam birama 5/4. Ikuti pola dengan tempo nyaman dan jaga setiap subdivisi tetap rata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài tập Nhịp lẻ ở nhịp 5/4. Theo mẫu ở tốc độ thoải mái và giữ các phân nhịp đều nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบฝึก จังหวะห้องคี่ ในจังหวะ 5/4 เล่นตามรูปแบบด้วยความเร็วที่สบายและแบ่งจังหวะให้เท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5/4の変拍子練習です。無理のないテンポでパターンを追い、細分を均等に保ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5/4의 홀수 박자 연습입니다. 편안한 템포로 패턴을 따라가며 세분을 고르게 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5/4的奇数拍练习。用舒适的速度跟随节奏型，并保持细分均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5/4的奇數拍練習。用舒適的速度跟隨節奏型，並保持細分均勻。"
          }
        }
      }
    },
    "pattern.five-four-half-time.focus": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the five-beat phrase while leaving space around the snare"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un pulso constante y acentos claros en este patrón de Compás irregular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez une pulsation stable et des accents nets dans ce motif Mesure asymétrique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Puls stabil und setze klare Akzente in diesem Ungerader Takt-Muster."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a pulsação firme e os acentos claros neste padrão de Compasso ímpar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni un pulsare costante e accenti chiari in questo pattern Metro dispari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de puls stabiel en de accenten duidelijk in dit Oneven maatsoort-patroon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj równy puls i wyraźne akcenty w tym wzorze Metrum nieparzyste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримай рівний пульс і чіткі акценти у вправі Непарний розмір."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держи ровный пульс и чёткие акценты в упражнении Нечётный размер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Aksak ölçü kalıbında vuruşu sabit, vurguları net tut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على نبض ثابت ونبرات واضحة في نمط ميزان فردي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו על פעמה יציבה והדגשות ברורות בתרגיל משקל אי־זוגי."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این الگوی میزان فرد ضربی ثابت و تأکیدهایی روشن نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस विषम ताल पैटर्न में स्थिर ताल और स्पष्ट ज़ोर बनाए रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বিজোড় মাত্রা প্যাটার্নে স্থির পালস ও স্পষ্ট অ্যাকসেন্ট রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس طاق میزان پیٹرن میں مستقل لے اور واضح زور برقرار رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga pulsa tetap stabil dan aksen tetap jelas dalam pola Birama ganjil ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nhịp ổn định và nhấn rõ trong mẫu Nhịp lẻ này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาจังหวะให้สม่ำเสมอและเน้นเสียงให้ชัดในรูปแบบ จังหวะห้องคี่ นี้"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変拍子パターンでは、安定した拍と明確なアクセントを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 홀수 박자 패턴에서 박을 일정하게 유지하고 강세를 또렷하게 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个奇数拍节奏型中保持稳定的脉搏和清晰的重音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這個奇數拍節奏型中保持穩定的脈動和清楚的重音。"
          }
        }
      }
    },
