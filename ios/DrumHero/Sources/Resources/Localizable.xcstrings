    "dashboard.tool.learn.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twelve guided lessons from first setup to polyrhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doce lecciones guiadas, desde la primera configuración hasta la polirritmia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Douze leçons guidées, de l’installation aux polyrythmies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwölf geführte Lektionen vom ersten Aufbau bis zur Polyrhythmik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Doze aulas guiadas, da primeira configuração à polirritmia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodici lezioni guidate dalla prima configurazione alla poliritmia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twaalf begeleide lessen, van de eerste opstelling tot polyrhythmiek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwanaście lekcji od pierwszego ustawienia zestawu po polirytmię."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дванадцять уроків: від першого налаштування до поліритмії."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двенадцать уроков от первой настройки установки до полиритмии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk kurulumdan poliritme kadar rehberli on iki ders."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اثنا عشر درسًا موجّهًا من الإعداد الأول إلى تعدد الإيقاع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שנים עשר שיעורים מודרכים, מההתקנה הראשונה ועד פוליריתמיקה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دوازده درس راهنما از نخستین چیدمان تا پولیریتم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहली सेटअप से पॉलीरिदम तक बारह मार्गदर्शित पाठ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথম সেটআপ থেকে পলিরিদম পর্যন্ত বারোটি নির্দেশিত পাঠ।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلی ترتیب سے پولی ردھم تک بارہ رہنمائی والے اسباق۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua belas pelajaran terpandu dari penataan pertama hingga poliritme."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mười hai bài học có hướng dẫn, từ cách bố trí đầu tiên đến đa tiết tấu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บทเรียนมีคำแนะนำสิบสองบท ตั้งแต่การจัดชุดครั้งแรกจนถึงโพลีริทึม"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のセットアップからポリリズムまで、12のガイド付きレッスン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 세팅부터 폴리리듬까지 이어지는 열두 개의 가이드 레슨."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从首次设置到复合节奏的十二节引导课程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從首次設定到複合節奏的十二堂引導課程。"
          }
        }
      }
    },
