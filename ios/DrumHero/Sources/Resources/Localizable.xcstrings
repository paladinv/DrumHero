    "pattern.fill-seven-eight-grouped.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fourteen-note sixteenth fill in 7/8 marks each group with an accent before resolving at the next bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio de Estudio de rellenos en 7/8. Sigue el patrón a un tempo cómodo y mantén parejas las subdivisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice Étude de breaks en 7/8. Suivez le motif à un tempo confortable et gardez des subdivisions régulières."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Fill-Übung-Übung im Takt 7/8. Folge dem Muster in bequemem Tempo und halte die Unterteilungen gleichmäßig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercício de Estudo de viradas em 7/8. Siga o padrão em um andamento confortável e mantenha as subdivisões regulares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizio Studio dei fill in 7/8. Segui il pattern a un tempo comodo e mantieni regolari le suddivisioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Fill-oefening-oefening in 7/8. Volg het patroon op een prettig tempo en houd de onderverdelingen gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenie Ćwiczenie przejść w metrum 7/8. Graj wzór w wygodnym tempie i zachowaj równe podziały."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вправа у стилі Вправа на філи в розмірі 7/8. Грай у зручному темпі та тримай рівні підрозділи."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнение в стиле Упражнение на филы и размере 7/8. Играй в удобном темпе и соблюдай ровные доли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7/8 ölçüsünde Dolgu çalışması çalışması. Kalıbı rahat bir tempoda izle ve alt bölümleri eşit tut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرين تمرين فِل بإيقاع 7/8. اتبع النمط بسرعة مريحة وحافظ على تساوي التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגיל תרגיל מעברים במשקל 7/8. נגנו בקצב נוח ושמרו על חלוקות שוות."
