    "dashboard.tool.practice.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Train timing with five playable kit voices and honest feedback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrena el ritmo con cinco voces de batería y comentarios claros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travaillez le rythme avec cinq sons de batterie et un retour clair."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainiere dein Timing mit fünf spielbaren Schlagzeugstimmen und klarem Feedback."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Treine o tempo com cinco timbres de bateria e feedback claro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allena il tempo con cinque suoni di batteria e un feedback chiaro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Train je timing met vijf speelbare drumklanken en duidelijke feedback."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz timing z pięcioma głosami zestawu i czytelną informacją zwrotną."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренуй таймінг із п’ятьма тембрами установки та зрозумілим відгуком."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренируй тайминг на пяти голосах установки и получай понятную обратную связь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş çalınabilir davul sesi ve anlaşılır geri bildirimle zamanlamanı geliştir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "درّب التوقيت باستخدام خمسة أصوات للطقم وملاحظات واضحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתרגלים תזמון עם חמישה קולות תופים ומשוב ברור."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان‌بندی را با پنج صدای درام و بازخورد روشن تمرین کن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाँच बजाने योग्य ड्रम आवाज़ों और साफ़ प्रतिक्रिया के साथ टाइमिंग का अभ्यास करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাঁচটি বাজানো যায় এমন ড্রাম কণ্ঠ ও স্পষ্ট প্রতিক্রিয়ায় টাইমিং অনুশীলন করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پانچ بجانے کے قابل ڈرم آوازوں اور واضح رائے سے ٹائمنگ کی مشق کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih ketepatan waktu dengan lima suara drum dan umpan balik yang jelas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rèn luyện nhịp với năm âm sắc trống và phản hồi rõ ràng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝึกจังหวะด้วยเสียงกลองห้าแบบและคำแนะนำที่ชัดเจน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5つのドラム音色と明確なフィードバックでタイミングを練習。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다섯 가지 드럼 음색과 명확한 피드백으로 타이밍을 연습하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用五种可演奏的鼓组音色和清晰反馈训练节奏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用五種可演奏的鼓組音色和清楚回饋訓練節奏。"
          }
        }
      }
    },
