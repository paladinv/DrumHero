    "No setup or account needed. Use the five on-screen pads or press Space, F, J, K, and L with the count-in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas configurar nada ni crear una cuenta. Usa los cinco pads en pantalla o pulsa Espacio, F, J, K y L durante la cuenta atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune configuration ni aucun compte requis. Utilisez les cinq pads à l’écran ou appuyez sur Espace, F, J, K et L pendant le décompte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Einrichtung und kein Konto nötig. Nutze die fünf Pads auf dem Bildschirm oder während des Count-ins die Tasten Leertaste, F, J, K und L."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não precisa configurar nem criar uma conta. Use os cinco pads na tela ou pressione Espaço, F, J, K e L durante a contagem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non serve configurare o creare un account. Usa i cinque pad sullo schermo o premi Spazio, F, J, K e L durante il conteggio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen installatie of account nodig. Gebruik de vijf pads op het scherm of druk tijdens het aftellen op Spatie, F, J, K en L."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie musisz nic konfigurować ani zakładać konta. Użyj pięciu padów na ekranie lub klawiszy Spacja, F, J, K i L podczas odliczania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування та обліковий запис не потрібні. Використовуй п’ять екранних педів або натискай Пробіл, F, J, K і L під час відліку."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка и аккаунт не нужны. Используй пять экранных пэдов или нажимай Пробел, F, J, K и L во время отсчёта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum veya hesap gerekmez. Ekrandaki beş pedi kullan ya da sayım sırasında Boşluk, F, J, K ve L tuşlarına bas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتاج إلى إعداد أو حساب. استخدم الوسادات الخمس على الشاشة أو اضغط Space وF وJ وK وL أثناء العد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין צורך בהגדרה או בחשבון. השתמשו בחמשת הפדים שעל המסך או לחצו על רווח, F, J, K ו-L בזמן הספירה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به راه‌اندازی یا حساب نیاز نیست. از پنج پد روی صفحه استفاده کن یا هنگام شمارش Space و F و J و K و L را بزن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटअप या खाते की ज़रूरत नहीं। स्क्रीन के पाँच पैड इस्तेमाल करें या काउंट-इन के दौरान Space, F, J, K और L दबाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটআপ বা অ্যাকাউন্ট দরকার নেই। স্ক্রিনের পাঁচটি প্যাড ব্যবহার করুন অথবা কাউন্ট-ইনের সময় Space, F, J, K ও L চাপুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیٹ اپ یا اکاؤنٹ کی ضرورت نہیں۔ اسکرین کے پانچ پیڈ استعمال کریں یا گنتی کے دوران Space، F، J، K اور L دبائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak perlu pengaturan atau akun. Gunakan lima pad di layar atau tekan Space, F, J, K, dan L saat hitung masuk."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần cài đặt hay tài khoản. Dùng năm pad trên màn hình hoặc nhấn Space, F, J, K và L trong phần đếm nhịp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องตั้งค่าหรือมีบัญชี ใช้แพดห้าปุ่มบนหน้าจอหรือกด Space, F, J, K และ L ระหว่างนับนำ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定やアカウントは不要です。画面上の5つのパッドを使うか、カウントイン中にSpace、F、J、K、Lを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정이나 계정이 필요 없습니다. 화면의 패드 5개를 사용하거나 카운트인 중 Space, F, J, K, L을 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需设置或账号。使用屏幕上的五个鼓垫，或在预备拍时按空格、F、J、K 和 L。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需設定或帳號。使用畫面上的五個鼓墊，或在預備拍時按空白鍵、F、J、K 和 L。"
          }
        }
      }
    },
