    "pattern.fill-accent-groups-of-three.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sixteenth notes continue evenly as accents repeat every three steps, shifting against the four-beat bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio de Estudio de rellenos en 4/4. Sigue el patrón a un tempo cómodo y mantén parejas las subdivisiones."
          }
        },
        "fr": {
