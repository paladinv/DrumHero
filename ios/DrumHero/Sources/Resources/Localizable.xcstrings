    "Check each item after you can do it comfortably.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca cada elemento cuando puedas hacerlo cómodamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez chaque élément lorsque vous le maîtrisez confortablement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake jeden Punkt ab, sobald du ihn sicher beherrschst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque cada item quando conseguir fazê-lo com tranquilidade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona ogni elemento quando riesci a farlo con sicurezza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vink elk onderdeel aan zodra je het comfortabel kunt uitvoeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz każdy punkt, gdy wykonujesz go swobodnie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначайте кожен пункт, коли виконуєте його впевнено."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечайте каждый пункт, когда выполняете его уверенно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her maddeyi rahatça yapabildiğinde işaretle."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد كل بند عندما تتمكن من أدائه براحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמנו כל פריט לאחר שתצליחו לבצע אותו בנוחות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر مورد را وقتی با آسودگی انجام دادید علامت بزنید."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बिंदु को तब चिह्नित करें जब आप उसे सहजता से कर सकें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বচ্ছন্দে করতে পারলে প্রতিটি আইটেমে টিক দিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب ہر کام آسانی سے کر سکیں تو اسے نشان زد کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Centang setiap item setelah kamu bisa melakukannya dengan nyaman."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu từng mục khi bạn có thể thực hiện thoải mái."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเครื่องหมายแต่ละข้อเมื่อทำได้อย่างสบาย"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無理なくできるようになった項目にチェックを付けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안하게 할 수 있게 되면 각 항목을 체크하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能够轻松完成每一项后再勾选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能夠輕鬆完成每一項後再勾選。"
          }
        }
      }
    },
