    "pattern.gospel-sixteenth-pocket.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A busy sixteenth-note coordination pattern with syncopated kick and snare accents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio de Gospel en 4/4. Sigue el patrón a un tempo cómodo y mantén parejas las subdivisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice Gospel en 4/4. Suivez le motif à un tempo confortable et gardez des subdivisions régulières."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gospel-Übung im Takt 4/4. Folge dem Muster in bequemem Tempo und halte die Unterteilungen gleichmäßig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercício de Gospel em 4/4. Siga o padrão em um andamento confortável e mantenha as subdivisões regulares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizio Gospel in 4/4. Segui il pattern a un tempo comodo e mantieni regolari le suddivisioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Gospel-oefening in 4/4. Volg het patroon op een prettig tempo en houd de onderverdelingen gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenie Gospel w metrum 4/4. Graj wzór w wygodnym tempie i zachowaj równe podziały."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вправа у стилі Gospel в розмірі 4/4. Грай у зручному темпі та тримай рівні підрозділи."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнение в стиле Gospel и размере 4/4. Играй в удобном темпе и соблюдай ровные доли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4 ölçüsünde Gospel çalışması. Kalıbı rahat bir tempoda izle ve alt bölümleri eşit tut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرين Gospel بإيقاع 4/4. اتبع النمط بسرعة مريحة وحافظ على تساوي التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגיל Gospel במשקל 4/4. נגנו בקצב נוח ושמרו על חלוקות שוות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرین Gospel در میزان 4/4. الگو را با سرعتی راحت بنواز و تقسیمات را یکسان نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4 में Gospel अभ्यास। आरामदायक गति से पैटर्न बजाएँ और उपविभाजनों को बराबर रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4 মাত্রায় Gospel অনুশীলন। স্বচ্ছন্দ গতিতে প্যাটার্নটি অনুসরণ করুন এবং উপবিভাগ সমান রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4 میں Gospel کی مشق۔ آرام دہ رفتار سے پیٹرن بجائیں اور ذیلی تقسیمیں برابر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Gospel dalam birama 4/4. Ikuti pola dengan tempo nyaman dan jaga setiap subdivisi tetap rata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài tập Gospel ở nhịp 4/4. Theo mẫu ở tốc độ thoải mái và giữ các phân nhịp đều nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบฝึก Gospel ในจังหวะ 4/4 เล่นตามรูปแบบด้วยความเร็วที่สบายและแบ่งจังหวะให้เท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4のGospel練習です。無理のないテンポでパターンを追い、細分を均等に保ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4의 Gospel 연습입니다. 편안한 템포로 패턴을 따라가며 세분을 고르게 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4的Gospel练习。用舒适的速度跟随节奏型，并保持细分均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4的Gospel練習。用舒適的速度跟隨節奏型，並保持細分均勻。"
          }
        }
      }
    },
    "pattern.gospel-sixteenth-pocket.focus": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit displaced snare accents around the anchor beats"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un pulso constante y acentos claros en este patrón de Gospel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez une pulsation stable et des accents nets dans ce motif Gospel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Puls stabil und setze klare Akzente in diesem Gospel-Muster."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a pulsação firme e os acentos claros neste padrão de Gospel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni un pulsare costante e accenti chiari in questo pattern Gospel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de puls stabiel en de accenten duidelijk in dit Gospel-patroon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj równy puls i wyraźne akcenty w tym wzorze Gospel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримай рівний пульс і чіткі акценти у вправі Gospel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держи ровный пульс и чёткие акценты в упражнении Gospel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Gospel kalıbında vuruşu sabit, vurguları net tut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على نبض ثابت ونبرات واضحة في نمط Gospel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו על פעמה יציבה והדגשות ברורות בתרגיל Gospel."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این الگوی Gospel ضربی ثابت و تأکیدهایی روشن نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Gospel पैटर्न में स्थिर ताल और स्पष्ट ज़ोर बनाए रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Gospel প্যাটার্নে স্থির পালস ও স্পষ্ট অ্যাকসেন্ট রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Gospel پیٹرن میں مستقل لے اور واضح زور برقرار رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga pulsa tetap stabil dan aksen tetap jelas dalam pola Gospel ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nhịp ổn định và nhấn rõ trong mẫu Gospel này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาจังหวะให้สม่ำเสมอและเน้นเสียงให้ชัดในรูปแบบ Gospel นี้"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このGospelパターンでは、安定した拍と明確なアクセントを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Gospel 패턴에서 박을 일정하게 유지하고 강세를 또렷하게 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个Gospel节奏型中保持稳定的脉搏和清晰的重音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這個Gospel節奏型中保持穩定的脈動和清楚的重音。"
          }
        }
      }
    },
