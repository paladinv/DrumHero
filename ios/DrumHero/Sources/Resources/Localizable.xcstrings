        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个加花练习节奏型中保持稳定的脉搏和清晰的重音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
