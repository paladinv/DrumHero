        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Trainer kannst du USB-MIDI oder optional ein Mikrofon wählen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Treinador aceita MIDI USB ou entrada opcional de microfone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Trainer supporta MIDI USB o l’ingresso opzionale del microfono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainer ondersteunt USB-MIDI of optioneel microfooningang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trener obsługuje USB MIDI lub opcjonalne wejście mikrofonowe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренажер підтримує USB MIDI або додатковий вхід мікрофона."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренажёр поддерживает USB MIDI или дополнительный вход микрофона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğitmen USB MIDI’yi veya isteğe bağlı mikrofon girişini destekler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعم المدرّب MIDI عبر USB أو إدخال الميكروفون الاختياري."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאמן תומך ב-USB MIDI או בכניסת מיקרופון אופציונלית."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مربی از USB MIDI یا ورودی اختیاری میکروفون پشتیبانی می‌کند."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रेनर USB MIDI या वैकल्पिक माइक्रोफ़ोन इनपुट देता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রেইনার USB MIDI বা ঐচ্ছিক মাইক্রোফোন ইনপুট সমর্থন করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرینر USB MIDI یا اختیاری مائیکروفون ان پٹ کو سپورٹ کرتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelatih mendukung USB MIDI atau masukan mikrofon opsional."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huấn luyện hỗ trợ USB MIDI hoặc đầu vào mic tùy chọn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ฝึกสอนรองรับ USB MIDI หรืออินพุตไมโครโฟนเสริม"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレーナーはUSB MIDIまたは任意のマイク入力に対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트레이너는 USB MIDI 또는 선택적 마이크 입력을 지원합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练器支持 USB MIDI 或可选麦克风输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訓練器支援 USB MIDI 或選用麥克風輸入。"
          }
        }
      }
    },
