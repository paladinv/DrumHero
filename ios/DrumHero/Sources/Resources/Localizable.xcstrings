    "dashboard.tool.rudiments.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build control with sticking, accents, and focused coaching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrolla el control con técnica, acentos y guía enfocada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développez votre contrôle avec des doigtés, des accents et des conseils ciblés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickle Kontrolle mit Schlagfolgen, Akzenten und gezieltem Coaching."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenvolva controle com baqueteamento, acentos e orientação focada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sviluppa il controllo con sticking, accenti e indicazioni mirate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontwikkel controle met slagpatronen, accenten en gerichte coaching."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwijaj kontrolę dzięki układom rąk, akcentom i konkretnym wskazówkom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розвивай контроль за допомогою аплікатури, акцентів і цільових підказок."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Развивай контроль с помощью аппликатуры, акцентов и точных подсказок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "El düzeni, aksanlar ve odaklı yönlendirmeyle kontrol kazan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طوّر التحكم عبر حركات اليدين واللكنات والتوجيه المركّز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתחים שליטה בעזרת תבניות ידיים, הדגשות והדרכה ממוקדת."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با الگوهای دست، تأکیدها و راهنمایی متمرکز کنترل را بهتر کن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथों के पैटर्न, एक्सेंट और केंद्रित मार्गदर्शन से नियंत्रण बढ़ाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হাতের বিন্যাস, অ্যাকসেন্ট এবং নির্দিষ্ট নির্দেশনায় নিয়ন্ত্রণ গড়ুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاتھوں کی ترتیب، زور اور مرکوز رہنمائی سے کنٹرول بہتر بنائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun kontrol lewat pola sticking, aksen, dan panduan terarah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rèn khả năng kiểm soát với cách đánh tay, nhấn âm và hướng dẫn tập trung."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พัฒนาการควบคุมด้วยรูปแบบมือ การเน้นเสียง และคำแนะนำเฉพาะจุด"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手順、アクセント、的確なコーチングでコントロールを身につけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손 패턴, 강세, 집중 코칭으로 컨트롤을 키우세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过手法、重音和针对性指导建立控制力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過手法、重音和針對性指導建立控制力。"
          }
        }
      }
    },
