    "dashboard.tool.grooves.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow original rock, pop, funk, reggae, shuffle, Latin, and odd-meter patterns from simple to advanced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue patrones originales de rock, pop, funk, reggae, shuffle, música latina y compases irregulares, de fácil a avanzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez des motifs originaux de rock, pop, funk, reggae, shuffle, latin et mesures irrégulières, du niveau débutant à avancé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele eigene Rock-, Pop-, Funk-, Reggae-, Shuffle-, Latin- und ungerade Taktmuster von leicht bis anspruchsvoll."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe padrões originais de rock, pop, funk, reggae, shuffle, ritmos latinos e compassos ímpares, do básico ao avançado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui pattern originali rock, pop, funk, reggae, shuffle, latini e in tempi dispari, dal livello base a quello avanzato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg originele rock-, pop-, funk-, reggae-, shuffle-, Latin- en onevenmaatpatronen van eenvoudig tot gevorderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graj autorskie wzory rockowe, popowe, funkowe, reggae, shuffle, latynoskie i w nietypowych metrach — od łatwych po zaawansowane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грай авторські рок-, поп-, фанк-, регі-, шаффл-, латиноамериканські та непарні ритми — від простих до складних."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играй авторские рок-, поп-, фанк-, регги-, шаффл-, латинские ритмы и размеры с нечётным числом долей — от простых до сложных."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolaydan ileri seviyeye rock, pop, funk, reggae, shuffle, Latin ve aksak ölçülü özgün kalıpları takip et."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع أنماطًا أصلية من الروك والبوب والفانك والريغي والشافل واللاتينية والموازين الفردية، من السهل إلى المتقدم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנגנים מקצבי רוק, פופ, פאנק, רגאיי, שאפל, לטיני ומשקלים אי־זוגיים מקוריים — מפשוטים למתקדמים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "الگوهای اورجینال راک، پاپ، فانک، رگی، شافل، لاتین و میزان‌های فرد را از ساده تا پیشرفته دنبال کن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सरल से उन्नत तक मौलिक रॉक, पॉप, फ़ंक, रेगे, शफ़ल, लैटिन और विषम ताल वाले पैटर्न बजाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সহজ থেকে উন্নত পর্যন্ত মৌলিক রক, পপ, ফাঙ্ক, রেগে, শাফল, ল্যাটিন ও বিজোড় মাত্রার প্যাটার্ন অনুসরণ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آسان سے اعلیٰ سطح تک اصل راک، پاپ، فنک، ریگی، شفل، لاطینی اور طاق میزان کے پیٹرن بجائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti pola orisinal rock, pop, funk, reggae, shuffle, Latin, dan birama ganjil dari dasar hingga mahir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo các mẫu rock, pop, funk, reggae, shuffle, Latin và nhịp lẻ nguyên bản từ cơ bản đến nâng cao."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นรูปแบบต้นฉบับแนวร็อก ป๊อป ฟังก์ เร็กเก้ ชัฟเฟิล ละติน และจังหวะห้องคี่ ตั้งแต่ง่ายจนถึงขั้นสูง"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック、ポップ、ファンク、レゲエ、シャッフル、ラテン、変拍子のオリジナルパターンを初級から上級まで演奏。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬운 단계부터 고급 단계까지 오리지널 록, 팝, 펑크, 레게, 셔플, 라틴 및 홀수 박자 패턴을 따라 연주하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从简单到进阶，跟练原创摇滚、流行、放克、雷鬼、摇摆、拉丁和奇数拍节奏型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從簡單到進階，跟練原創搖滾、流行、放克、雷鬼、搖擺、拉丁和奇數拍節奏型。"
          }
        }
      }
    },
    "dashboard.tool.songs.title": {
      "localizations": {
        "en": {
