    "dashboard.tool.songs.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build drum parts, organize repertoire, and practice song sections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea partes de batería, organiza tu repertorio y practica secciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez des parties de batterie, organisez votre répertoire et travaillez les sections."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle Schlagzeugparts, ordne dein Repertoire und übe Songabschnitte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie partes de bateria, organize seu repertório e pratique trechos das músicas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea parti di batteria, organizza il repertorio e prova le sezioni dei brani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw drumpartijen, orden je repertoire en oefen songdelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twórz partie perkusji, porządkuj repertuar i ćwicz sekcje utworów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створюй партії ударних, упорядковуй репертуар і практикуй частини пісень."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавай партии ударных, упорядочивай репертуар и практикуй части песен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davul bölümleri oluştur, repertuvarını düzenle ve şarkı bölümlerini çalış."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ أجزاء الطبول ونظّم قائمة أغانيك وتدرّب على المقاطع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יוצרים תפקידי תופים, מארגנים רפרטואר ומתרגלים חלקים משירים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بخش‌های درام بساز، فهرست آهنگ‌ها را مرتب کن و قسمت‌های آهنگ را تمرین کن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्रम पार्ट बनाएँ, अपने गीत व्यवस्थित करें और गीत के हिस्सों का अभ्यास करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ড্রাম অংশ তৈরি করুন, গান সাজান এবং গানের অংশ অনুশীলন করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈرم کے حصے بنائیں، ذخیرۂ گیت منظم کریں اور گیت کے حصوں کی مشق کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat bagian drum, atur repertoar, dan latih bagian lagu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo phần trống, sắp xếp tiết mục và luyện từng đoạn bài hát."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างพาร์ตกลอง จัดเพลง และฝึกซ้อมทีละท่อน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラムパートを作り、レパートリーを整理し、曲の各セクションを練習。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드럼 파트를 만들고 레퍼토리를 정리하고 곡의 각 부분을 연습하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编写鼓组声部、整理曲目并练习歌曲片段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編寫鼓組聲部、整理曲目並練習歌曲片段。"
          }
        }
      }
    },
