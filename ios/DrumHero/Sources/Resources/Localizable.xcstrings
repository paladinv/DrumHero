        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 홀수 박자 패턴에서 박을 일정하게 유지하고 강세를 또렷하게 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
