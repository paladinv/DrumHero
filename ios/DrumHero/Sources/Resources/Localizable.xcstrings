        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على نبض ثابت ونبرات واضحة في نمط إيقاع + فِل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו על פעמה יציבה והדגשות ברורות בתרגיל גרוב + מעבר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این الگوی گروو + فیل ضربی ثابت و تأکیدهایی روشن نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ग्रोव + फिल पैटर्न में स्थिर ताल और स्पष्ट ज़ोर बनाए रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই গ্রুভ + ফিল প্যাটার্নে স্থির পালস ও স্পষ্ট অ্যাকসেন্ট রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس گروو + فل پیٹرن میں مستقل لے اور واضح زور برقرار رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga pulsa tetap stabil dan aksen tetap jelas dalam pola Groove + fill ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nhịp ổn định và nhấn rõ trong mẫu Groove + fill này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาจังหวะให้สม่ำเสมอและเน้นเสียงให้ชัดในรูปแบบ กรูฟ + ฟิล นี้"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグルーヴ＋フィルパターンでは、安定した拍と明確なアクセントを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그루브 + 필 패턴에서 박을 일정하게 유지하고 강세를 또렷하게 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个律动＋加花节奏型中保持稳定的脉搏和清晰的重音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這個律動＋過門節奏型中保持穩定的脈動和清楚的重音。"
          }
        }
      }
    },
