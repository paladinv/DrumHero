          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel het patroon langzaam en houd elke onderverdeling gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graj powoli, zachowując równe odstępy między podziałami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грай повільно, рівномірно розподіляючи кожен підрозділ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играй медленно, равномерно распределяя каждую долю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş çal; her alt bölümü eşit aralıklarla yerleştir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزف النمط ببطء وحافظ على تساوي المسافات بين التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נגנו לאט ושמרו על מרווחים שווים בין החלוקות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهسته بنواز و فاصلهٔ تقسیم‌ها را برابر نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे बजाएँ और हर उपविभाजन के बीच बराबर दूरी रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধীরে বাজান; প্রতিটি উপবিভাগের ব্যবধান সমান রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آہستہ بجائیں اور ہر ذیلی تقسیم کا فاصلہ برابر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainkan perlahan; jaga jarak setiap subdivisi tetap sama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi chậm, giữ khoảng cách giữa các phân nhịp bằng nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นช้า ๆ โดยเว้นระยะของแต่ละจังหวะย่อยให้เท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり演奏し、各細分の間隔を均等に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 연주하며 각 세분의 간격을 고르게 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，让每个细分之间的间隔保持均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，讓每個細分之間的間隔保持均勻。"
          }
        }
      }
    },
    "lesson.dynamic-arc.goal.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep pulse independent of volume"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repítelo hasta tocarlo con soltura y regularidad; después, sube un poco el tempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez jusqu’à jouer avec aisance et régularité, puis augmentez légèrement le tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole es entspannt und gleichmäßig, dann erhöhe das Tempo leicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita até tocar com tranquilidade e constância; depois, aumente um pouco o andamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti finché il gesto è rilassato e uniforme, poi aumenta leggermente il tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhaal tot het ontspannen en gelijkmatig voelt; verhoog daarna het tempo een beetje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powtarzaj, aż ruch będzie swobodny i równy, a potem lekko zwiększ tempo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторюй, доки рух не стане вільним і рівним, тоді трохи прискорся."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяй, пока движения не станут свободными и ровными, затем немного ускорься."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat ve dengeli olana kadar tekrarla, sonra tempoyu biraz artır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرّر حتى يصبح العزف مريحًا ومنتظمًا، ثم زد السرعة قليلًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזרו עד שהנגינה נינוחה ואחידה, ואז הגבירו מעט את הקצב."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا وقتی حرکت راحت و یکنواخت شود تکرار کن، سپس کمی سرعت را بالا ببر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम और समानता आने तक दोहराएँ, फिर गति थोड़ी बढ़ाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বচ্ছন্দ ও সমান না হওয়া পর্যন্ত পুনরাবৃত্তি করুন, তারপর গতি সামান্য বাড়ান।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرام اور یکسانیت آنے تک دہرائیں، پھر رفتار تھوڑی بڑھائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulangi sampai terasa santai dan rata, lalu naikkan tempo sedikit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lặp lại đến khi thấy thư giãn và đều, rồi tăng tốc một chút."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นซ้ำจนรู้สึกผ่อนคลายและสม่ำเสมอ แล้วค่อยเพิ่มความเร็วเล็กน้อย"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "力まず均等に演奏できるまで繰り返し、その後少しだけテンポを上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안하고 고르게 연주될 때까지 반복한 뒤 템포를 조금 높이세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复练习，直到动作放松且均匀，再稍微加快速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複練習，直到動作放鬆且均勻，再稍微加快速度。"
          }
        }
      }
    },
    "lesson.three-over-two.idea": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 3:2 polyrhythm places three evenly spaced notes over the same span as two evenly spaced notes. Learn each pulse separately before combining them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiende y coordina el polirritmo 3:2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprenez et coordonnez la polyrythmie 3:2."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstehe und koordiniere die 3:2-Polyrhythmik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entenda e coordene a polirritmia 3:2."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprendi e coordina la poliritmia 3:2."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrijp en coördineer de 3:2-polyrhythmiek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznaj i skoordynuj polirytmię 3:2."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зрозумій і скоординуй поліритм 3:2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пойми и скоординируй полиритм 3:2."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3:2 poliritmini anla ve eşgüdümle."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افهم الإيقاع المتعدد 3:2 ونسّقه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבינו ותאמו את הפוליריתמיקה 3:2."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پلی‌ریتم ۳:۲ را درک و هماهنگ کنید."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3:2 पॉलीरिदम को समझें और समन्वित करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৩:২ পলিরিদম বুঝুন ও সমন্বয় করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "3:2 پولی ردھم سمجھیں اور ہم آہنگ کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahami dan koordinasikan poliritme 3:2."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiểu và phối hợp đa nhịp 3:2."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำความเข้าใจและประสานพอลิริธึม 3:2"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3:2のポリリズムを理解して合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3:2 폴리리듬을 이해하고 맞춰 연주하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "理解并协调3:2复合节奏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "理解並協調3:2複合節奏。"
          }
        }
      }
    },
    "lesson.three-over-two.step.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clap two even notes across a steady two-beat span."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a un tempo cómodo y di la cuenta en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à un tempo confortable et comptez à voix haute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne in einem angenehmen Tempo und zähle laut mit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece em um andamento confortável e fale a contagem em voz alta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a un tempo comodo e pronuncia il conteggio ad alta voce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin op een prettig tempo en tel hardop mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij w wygodnym tempie i licz na głos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почни у зручному темпі й рахуй уголос."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начни в удобном темпе и считай вслух."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat bir tempoda başla ve sayımı sesli yap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بسرعة مريحة وردّد العد بصوت مسموع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחילו בקצב נוח וספרו בקול."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با سرعتی راحت شروع کن و شمارش را با صدای بلند بگو."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आरामदायक गति से शुरू करें और गिनती बोलकर करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বচ্ছন্দ গতিতে শুরু করুন এবং জোরে গুনুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرام دہ رفتار سے شروع کریں اور گنتی بلند آواز میں کہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan tempo nyaman dan ucapkan hitungan dengan lantang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu ở tốc độ thoải mái và đếm thành tiếng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มด้วยความเร็วที่สบายและนับออกเสียง"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無理のないテンポで始め、声に出して数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안한 템포로 시작하고 소리 내어 세세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从舒适的速度开始，并大声数拍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從舒適的速度開始，並大聲數拍。"
          }
        }
      }
    },
    "lesson.three-over-two.step.2": {
      "localizations": {
        "en": {
