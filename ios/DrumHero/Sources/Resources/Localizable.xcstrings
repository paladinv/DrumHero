    "pattern.rock-syncopation-step.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A familiar backbeat with a kick pickup that pulls the phrase into the next bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio de Rock en 4/4. Sigue el patrón a un tempo cómodo y mantén parejas las subdivisiones."
          }
        },
        "fr": {
