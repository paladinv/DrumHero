            "value": "Lead with either hand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a un tempo cómodo y di la cuenta en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à un tempo confortable et comptez à voix haute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne in einem angenehmen Tempo und zähle laut mit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece em um andamento confortável e fale a contagem em voz alta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a un tempo comodo e pronuncia il conteggio ad alta voce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin op een prettig tempo en tel hardop mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij w wygodnym tempie i licz na głos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почни у зручному темпі й рахуй уголос."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начни в удобном темпе и считай вслух."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat bir tempoda başla ve sayımı sesli yap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بسرعة مريحة وردّد العد بصوت مسموع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחילו בקצב נוח וספרו בקול."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با سرعتی راحت شروع کن و شمارش را با صدای بلند بگو."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आरामदायक गति से शुरू करें और गिनती बोलकर करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বচ্ছন্দ গতিতে শুরু করুন এবং জোরে গুনুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرام دہ رفتار سے شروع کریں اور گنتی بلند آواز میں کہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan tempo nyaman dan ucapkan hitungan dengan lantang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu ở tốc độ thoải mái và đếm thành tiếng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มด้วยความเร็วที่สบายและนับออกเสียง"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無理のないテンポで始め、声に出して数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안한 템포로 시작하고 소리 내어 세세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从舒适的速度开始，并大声数拍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從舒適的速度開始，並大聲數拍。"
          }
        }
      }
    },
    "lesson.first-fill.goal.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move without rushing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el patrón despacio y mantén iguales las subdivisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez lentement en espaçant régulièrement chaque subdivision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele das Muster langsam und halte alle Unterteilungen gleichmäßig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque o padrão devagar e mantenha as subdivisões igualmente espaçadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona lentamente e mantieni regolare la distanza tra le suddivisioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel het patroon langzaam en houd elke onderverdeling gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graj powoli, zachowując równe odstępy między podziałami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грай повільно, рівномірно розподіляючи кожен підрозділ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играй медленно, равномерно распределяя каждую долю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş çal; her alt bölümü eşit aralıklarla yerleştir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزف النمط ببطء وحافظ على تساوي المسافات بين التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נגנו לאט ושמרו על מרווחים שווים בין החלוקות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهسته بنواز و فاصلهٔ تقسیم‌ها را برابر نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे बजाएँ और हर उपविभाजन के बीच बराबर दूरी रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধীরে বাজান; প্রতিটি উপবিভাগের ব্যবধান সমান রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آہستہ بجائیں اور ہر ذیلی تقسیم کا فاصلہ برابر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainkan perlahan; jaga jarak setiap subdivisi tetap sama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi chậm, giữ khoảng cách giữa các phân nhịp bằng nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นช้า ๆ โดยเว้นระยะของแต่ละจังหวะย่อยให้เท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり演奏し、各細分の間隔を均等に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 연주하며 각 세분의 간격을 고르게 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，让每个细分之间的间隔保持均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速演奏，讓每個細分之間的間隔保持均勻。"
          }
        }
      }
    },
    "lesson.first-fill.goal.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crash with the kick"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repítelo hasta tocarlo con soltura y regularidad; después, sube un poco el tempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez jusqu’à jouer avec aisance et régularité, puis augmentez légèrement le tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole es entspannt und gleichmäßig, dann erhöhe das Tempo leicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita até tocar com tranquilidade e constância; depois, aumente um pouco o andamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti finché il gesto è rilassato e uniforme, poi aumenta leggermente il tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhaal tot het ontspannen en gelijkmatig voelt; verhoog daarna het tempo een beetje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powtarzaj, aż ruch będzie swobodny i równy, a potem lekko zwiększ tempo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторюй, доки рух не стане вільним і рівним, тоді трохи прискорся."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяй, пока движения не станут свободными и ровными, затем немного ускорься."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat ve dengeli olana kadar tekrarla, sonra tempoyu biraz artır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرّر حتى يصبح العزف مريحًا ومنتظمًا، ثم زد السرعة قليلًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזרו עד שהנגינה נינוחה ואחידה, ואז הגבירו מעט את הקצב."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا وقتی حرکت راحت و یکنواخت شود تکرار کن، سپس کمی سرعت را بالا ببر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम और समानता आने तक दोहराएँ, फिर गति थोड़ी बढ़ाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বচ্ছন্দ ও সমান না হওয়া পর্যন্ত পুনরাবৃত্তি করুন, তারপর গতি সামান্য বাড়ান।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرام اور یکسانیت آنے تک دہرائیں، پھر رفتار تھوڑی بڑھائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulangi sampai terasa santai dan rata, lalu naikkan tempo sedikit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lặp lại đến khi thấy thư giãn và đều, rồi tăng tốc một chút."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นซ้ำจนรู้สึกผ่อนคลายและสม่ำเสมอ แล้วค่อยเพิ่มความเร็วเล็กน้อย"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "力まず均等に演奏できるまで繰り返し、その後少しだけテンポを上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안하고 고르게 연주될 때까지 반복한 뒤 템포를 조금 높이세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复练习，直到动作放松且均匀，再稍微加快速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複練習，直到動作放鬆且均勻，再稍微加快速度。"
          }
        }
      }
    },
    "lesson.sixteenth-control.idea": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sixteenth notes divide a beat into four equal positions, commonly counted “1 e & a”. Relaxed, even spacing matters more than speed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide un pulso en cuatro notas espaciadas por igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Divisez un temps en quatre notes régulièrement espacées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile einen Schlag in vier gleichmäßig verteilte Noten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Divida um tempo em quatro notas igualmente espaçadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dividi un movimento in quattro note equidistanti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdeel één tel in vier gelijkmatig gespreide noten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podziel jedną miarę na cztery równo rozłożone nuty."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділи одну долю на чотири рівновіддалені ноти."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздели одну долю на четыре равномерно распределённые ноты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir vuruşu eşit aralıklı dört notaya böl."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قسّم النبضة إلى أربع نغمات متساوية التباعد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלקו פעמה אחת לארבעה צלילים במרווחים שווים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک ضرب را به چهار نت با فاصلهٔ برابر تقسیم کنید."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बीट को बराबर दूरी वाले चार नोट्स में बाँटें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি বিটকে সমান দূরত্বের চারটি নোটে ভাগ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک تھاپ کو برابر فاصلے والے چار نوٹس میں تقسیم کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagi satu ketukan menjadi empat not dengan jarak sama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia một phách thành bốn nốt cách đều nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบ่งหนึ่งจังหวะเป็นสี่โน้ตที่เว้นระยะเท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1拍を均等な間隔の4音に分けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 박을 간격이 같은 네 음으로 나누세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一拍细分为四个间隔均匀的音符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把一拍細分為四個間隔均勻的音符。"
          }
        }
      }
    },
