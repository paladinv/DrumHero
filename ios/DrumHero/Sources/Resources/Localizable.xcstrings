    "pattern.quarter-kick-backbeat.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarter-note kicks support the familiar snare on beats two and four."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio de Fundamentos en 4/4. Sigue el patrón a un tempo cómodo y mantén parejas las subdivisiones."
