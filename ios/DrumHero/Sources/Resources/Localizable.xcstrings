    "Eight original song examples are available offline.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay ocho canciones originales de ejemplo disponibles sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit morceaux originaux sont disponibles hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht originale Songbeispiele sind offline verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oito músicas originais de exemplo estão disponíveis offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Otto brani originali di esempio sono disponibili offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn acht originele voorbeeldnummers offline beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiem oryginalnych przykładowych utworów jest dostępnych offline."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вісім оригінальних композицій доступні офлайн."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восемь оригинальных примеров композиций доступны офлайн."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekiz özgün örnek şarkı çevrimdışı kullanılabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوفر ثماني مقطوعات أصلية نموذجية دون اتصال بالإنترنت."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמונה שירים מקוריים לדוגמה זמינים במצב לא מקוון."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشت قطعهٔ نمونهٔ اصلی به‌صورت آفلاین در دسترس هستند."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आठ मौलिक उदाहरण गीत ऑफ़लाइन उपलब्ध हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আটটি মৌলিক নমুনা গান অফলাইনে পাওয়া যায়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آٹھ اصل نمونہ گانے آف لائن دستیاب ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan lagu contoh orisinal tersedia secara offline."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có tám bài hát mẫu nguyên bản dùng được khi ngoại tuyến."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพลงตัวอย่างต้นฉบับแปดเพลงที่ใช้งานแบบออฟไลน์ได้"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
