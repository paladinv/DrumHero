    "dashboard.tool.kit.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up comfortably, understand every voice, and protect your hearing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el instrumento con comodidad, conoce cada voz y protege tu audición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez-vous confortablement, découvrez chaque son et protégez votre ouïe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte dein Set bequem ein, lerne jeden Klang kennen und schütze dein Gehör."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a bateria com conforto, conheça cada timbre e proteja sua audição."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola comodamente il set, conosci ogni suono e proteggi l’udito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je set comfortabel op, leer elke klank kennen en bescherm je gehoor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw wygodnie zestaw, poznaj każde brzmienie i chroń słuch."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зручно налаштуй установку, вивчи кожен тембр і бережи слух."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удобно настрой установку, изучи каждый тембр и береги слух."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Setini rahatça kur, her sesi tanı ve işitmeni koru."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط الطقم براحة وتعرّف على كل صوت واحمِ سمعك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכוונים בנוחות את הסט, לומדים כל צליל ושומרים על השמיעה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساز را راحت بچین، هر صدا را بشناس و از شنوایی محافظت کن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम से सेटअप करें, हर आवाज़ को समझें और सुनने की क्षमता बचाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরাম করে সেট সাজান, প্রতিটি কণ্ঠ বুঝুন এবং শ্রবণশক্তি রক্ষা করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرام سے سیٹ لگائیں، ہر آواز کو سمجھیں اور سماعت محفوظ رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur set dengan nyaman, pahami setiap suara, dan lindungi pendengaran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp đặt thoải mái, tìm hiểu từng âm sắc và bảo vệ thính giác."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดชุดให้สบาย ทำความเข้าใจทุกเสียง และปกป้องการได้ยิน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無理のない姿勢でセットを整え、各音色を知り、聴覚を守りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편안하게 세팅하고 각 음색을 이해하며 청력을 보호하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "舒适地设置鼓组，了解每种音色并保护听力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舒適地設定鼓組，了解每種音色並保護聽力。"
          }
        }
      }
    },
