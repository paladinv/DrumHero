    "pattern.reggae-rockers.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A steady roots-style kit exercise with four kicks and a light snare on two and four."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio de Reggae en 4/4. Sigue el patrón a un tempo cómodo y mantén parejas las subdivisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice Reggae en 4/4. Suivez le motif à un tempo confortable et gardez des subdivisions régulières."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Reggae-Übung im Takt 4/4. Folge dem Muster in bequemem Tempo und halte die Unterteilungen gleichmäßig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercício de Reggae em 4/4. Siga o padrão em um andamento confortável e mantenha as subdivisões regulares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizio Reggae in 4/4. Segui il pattern a un tempo comodo e mantieni regolari le suddivisioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Reggae-oefening in 4/4. Volg het patroon op een prettig tempo en houd de onderverdelingen gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenie Reggae w metrum 4/4. Graj wzór w wygodnym tempie i zachowaj równe podziały."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вправа у стилі Reggae в розмірі 4/4. Грай у зручному темпі та тримай рівні підрозділи."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнение в стиле Reggae и размере 4/4. Играй в удобном темпе и соблюдай ровные доли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4 ölçüsünde Reggae çalışması. Kalıbı rahat bir tempoda izle ve alt bölümleri eşit tut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرين Reggae بإيقاع 4/4. اتبع النمط بسرعة مريحة وحافظ على تساوي التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגיל Reggae במשקל 4/4. נגנו בקצב נוח ושמרו על חלוקות שוות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرین Reggae در میزان 4/4. الگو را با سرعتی راحت بنواز و تقسیمات را یکسان نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4 में Reggae अभ्यास। आरामदायक गति से पैटर्न बजाएँ और उपविभाजनों को बराबर रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4 মাত্রায় Reggae অনুশীলন। স্বচ্ছন্দ গতিতে প্যাটার্নটি অনুসরণ করুন এবং উপবিভাগ সমান রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4 میں Reggae کی مشق۔ آرام دہ رفتار سے پیٹرن بجائیں اور ذیلی تقسیمیں برابر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Reggae dalam birama 4/4. Ikuti pola dengan tempo nyaman dan jaga setiap subdivisi tetap rata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài tập Reggae ở nhịp 4/4. Theo mẫu ở tốc độ thoải mái và giữ các phân nhịp đều nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบฝึก Reggae ในจังหวะ 4/4 เล่นตามรูปแบบด้วยความเร็วที่สบายและแบ่งจังหวะให้เท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4のReggae練習です。無理のないテンポでパターンを追い、細分を均等に保ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4의 Reggae 연습입니다. 편안한 템포로 패턴을 따라가며 세분을 고르게 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4的Reggae练习。用舒适的速度跟随节奏型，并保持细分均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "4/4的Reggae練習。用舒適的速度跟隨節奏型，並保持細分均勻。"
          }
        }
      }
    },
