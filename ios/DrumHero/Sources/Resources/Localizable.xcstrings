    "pattern.three-four-jazz-waltz.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A triplet-grid ride pattern with light kick support and sparse snare comping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio de Jazz en 3/4. Sigue el patrón a un tempo cómodo y mantén parejas las subdivisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice Jazz en 3/4. Suivez le motif à un tempo confortable et gardez des subdivisions régulières."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Jazz-Übung im Takt 3/4. Folge dem Muster in bequemem Tempo und halte die Unterteilungen gleichmäßig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercício de Jazz em 3/4. Siga o padrão em um andamento confortável e mantenha as subdivisões regulares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizio Jazz in 3/4. Segui il pattern a un tempo comodo e mantieni regolari le suddivisioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Jazz-oefening in 3/4. Volg het patroon op een prettig tempo en houd de onderverdelingen gelijkmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenie Jazz w metrum 3/4. Graj wzór w wygodnym tempie i zachowaj równe podziały."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вправа у стилі Jazz в розмірі 3/4. Грай у зручному темпі та тримай рівні підрозділи."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнение в стиле Jazz и размере 3/4. Играй в удобном темпе и соблюдай ровные доли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3/4 ölçüsünde Jazz çalışması. Kalıbı rahat bir tempoda izle ve alt bölümleri eşit tut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرين Jazz بإيقاع 3/4. اتبع النمط بسرعة مريحة وحافظ على تساوي التقسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגיל Jazz במשקל 3/4. נגנו בקצב נוח ושמרו על חלוקות שוות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرین Jazz در میزان 3/4. الگو را با سرعتی راحت بنواز و تقسیمات را یکسان نگه دار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3/4 में Jazz अभ्यास। आरामदायक गति से पैटर्न बजाएँ और उपविभाजनों को बराबर रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "3/4 মাত্রায় Jazz অনুশীলন। স্বচ্ছন্দ গতিতে প্যাটার্নটি অনুসরণ করুন এবং উপবিভাগ সমান রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "3/4 میں Jazz کی مشق۔ آرام دہ رفتار سے پیٹرن بجائیں اور ذیلی تقسیمیں برابر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Jazz dalam birama 3/4. Ikuti pola dengan tempo nyaman dan jaga setiap subdivisi tetap rata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài tập Jazz ở nhịp 3/4. Theo mẫu ở tốc độ thoải mái và giữ các phân nhịp đều nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบฝึก Jazz ในจังหวะ 3/4 เล่นตามรูปแบบด้วยความเร็วที่สบายและแบ่งจังหวะให้เท่ากัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3/4のJazz練習です。無理のないテンポでパターンを追い、細分を均等に保ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3/4의 Jazz 연습입니다. 편안한 템포로 패턴을 따라가며 세분을 고르게 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3/4的Jazz练习。用舒适的速度跟随节奏型，并保持细分均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3/4的Jazz練習。用舒適的速度跟隨節奏型，並保持細分均勻。"
          }
        }
      }
    },
