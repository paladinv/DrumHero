    "pattern.fill-two-beat-eighths.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short two-beat snare fill that leaves the first half of the measure open for counting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio de Estudio de rellenos en 4/4. Sigue el patrón a un tempo cómodo y mantén parejas las subdivisiones."
          }
        },
        "fr": {
